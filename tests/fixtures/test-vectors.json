{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ground Truth Domain Test Vectors",
  "description": "Deterministyczne wektory testowe oparte na recenzowanej literaturze naukowej Tier 1-3 i normach branżowych (SCA, Barista Hustle, Gagné, Hendon, NAS)",
  "version": "1.0.0",
  "vectors": {
    "extraction_yield": [
      {
        "id": "EY-SCA-01",
        "citation": "Specialty Coffee Association, Coffee Brewing Handbook, 2020, s. 12",
        "formula": "EY% = (Liquid Water * TDS%) / Dose",
        "inputs": {
          "waterGrams": 250.0,
          "tdsPercent": 1.35,
          "coffeeDoseGrams": 15.0
        },
        "expected": {
          "extractionYieldPercent": 22.5,
          "rating": "over"
        }
      },
      {
        "id": "EY-SCA-02",
        "citation": "Specialty Coffee Association, Coffee Brewing Handbook, 2020, s. 12",
        "formula": "EY% = (Liquid Water * TDS%) / Dose",
        "inputs": {
          "waterGrams": 200.0,
          "tdsPercent": 1.20,
          "coffeeDoseGrams": 12.0
        },
        "expected": {
          "extractionYieldPercent": 20.0,
          "rating": "ideal"
        }
      },
      {
        "id": "EY-SCA-03",
        "citation": "Specialty Coffee Association, Coffee Brewing Handbook, 2020, s. 14",
        "formula": "EY% = (Liquid Water * TDS%) / Dose",
        "inputs": {
          "waterGrams": 250.0,
          "tdsPercent": 0.90,
          "coffeeDoseGrams": 15.0
        },
        "expected": {
          "extractionYieldPercent": 15.0,
          "rating": "under"
        }
      }
    ],
    "water_retention": [
      {
        "id": "WRI-GAGNE-01",
        "citation": "Jonathan Gagné, The Physics of Filter Coffee, Skyhorse Publishing, 2021, s. 45",
        "formula": "Yield = Water - (Dose * 2.0)",
        "inputs": {
          "waterGrams": 300.0,
          "coffeeDoseGrams": 18.0,
          "retentionFactor": 2.0
        },
        "expected": {
          "liquidYieldGrams": 264.0
        }
      },
      {
        "id": "WRI-GAGNE-02",
        "citation": "Jonathan Gagné, The Physics of Filter Coffee, Skyhorse Publishing, 2021, s. 47",
        "formula": "Yield = Water - (Dose * 2.1)",
        "inputs": {
          "waterGrams": 500.0,
          "coffeeDoseGrams": 30.0,
          "retentionFactor": 2.1
        },
        "expected": {
          "liquidYieldGrams": 437.0
        }
      }
    ],
    "water_chemistry": [
      {
        "id": "WATER-HENDON-01",
        "citation": "Christopher H. Hendon & Maxwell Colonna-Dashwood, Water for Coffee, 2015, s. 88",
        "formula": "1 dH = 17.848 ppm CaCO3",
        "inputs": {
          "ppmCaCO3": 71.392
        },
        "expected": {
          "degreesGerman": 4.0
        }
      },
      {
        "id": "WATER-BH-01",
        "citation": "Matt Perger, Barista Hustle Water Recipes, 2017",
        "formula": "Buffer Concentrate: 1g in 1L = 2 ppm KH; Hardness Concentrate: 1g in 1L = 2 ppm GH",
        "inputs": {
          "targetBufferKhPpm": 40.0,
          "targetHardnessGhPpm": 80.0,
          "targetWaterLiters": 1.0
        },
        "expected": {
          "bufferConcentrateGrams": 20.0,
          "hardnessConcentrateGrams": 40.0
        }
      }
    ],
    "caffeine_pharmacokinetics": [
      {
        "id": "KOF-NAS-01",
        "citation": "Institute of Medicine (US), Caffeine for the Sustainment of Mental Task Performance, National Academies Press, 2001, Rozdz. 2",
        "formula": "C(t) = C0 * 0.5^(t / 5.0)",
        "inputs": {
          "initialDoseMg": 160.0,
          "elapsedHours": 5.0,
          "halfLifeHours": 5.0
        },
        "expected": {
          "remainingMg": 80.0
        }
      },
      {
        "id": "KOF-NAS-02",
        "citation": "Institute of Medicine (US), Caffeine for the Sustainment of Mental Task Performance, National Academies Press, 2001, Rozdz. 2",
        "formula": "C(t) = C0 * 0.5^(t / 5.0)",
        "inputs": {
          "initialDoseMg": 160.0,
          "elapsedHours": 10.0,
          "halfLifeHours": 5.0
        },
        "expected": {
          "remainingMg": 40.0,
          "safeForSleepUnder50Mg": true
        }
      }
    ]
  }
}
