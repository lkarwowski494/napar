{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-core.json",
  "testRunner": "jest",
  "jest": {
    "configFile": "jest.mutation.config.js"
  },
  "mutate": [
    "src/core/unit-converter.ts",
    "src/core/water-chemistry.ts",
    "src/core/cost-calculator.ts",
    "src/core/domain-rules.ts",
    "src/core/timer-engine.ts",
    "src/core/database.ts",
    "src/core/app-access.ts",
    "src/core/backup.ts"
  ],
  "reporters": [
    "clear-text",
    "progress",
    "json"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "thresholds": {
    "high": 95,
    "low": 90,
    "break": 90
  },
  "concurrency": 2,
  "timeoutMS": 10000
}
